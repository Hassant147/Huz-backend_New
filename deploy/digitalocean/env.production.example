# Copy this file to /etc/huz-backend.env on the server.
# Then replace every placeholder with your real production value.

DJANGO_SETTINGS_MODULE=huz.settings

# Django security
SECRET_KEY=replace-with-a-new-long-random-secret
SECRET_KEY1=
SECRET_KEY2=
ALLOWED_HOSTS=hajjumrah.org,www.hajjumrah.org
CSRF_TRUSTED_ORIGINS=https://hajjumrah.org,https://www.hajjumrah.org
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
USE_X_FORWARDED_HOST=True

# API docs
ENABLE_API_DOCS=False

# CORS
CORS_ALLOW_ALL_ORIGINS=False
# Temporary development allowance:
# Keep localhost entries while your frontend is local.
# Remove them later when frontend moves fully to production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:5173,http://127.0.0.1:5173,https://hajjumrah.org,https://www.hajjumrah.org
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_HEADERS=

# Database
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=replace-with-db-host
DB_PORT=replace-with-db-port
DB_CONN_MAX_AGE=300
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SSL_CA=

# Static and media
SERVE_MEDIA_AND_STATIC_FROM_DJANGO=False
STATIC_ROOT=/srv/huz-backend/staticfiles
MEDIA_ROOT=/srv/huz-backend/media
VIEW_LOG_PATH=/srv/huz-backend/view_logs.txt

# External files
FIREBASE_CREDENTIAL_PATH=/srv/huz-backend/common/firebase.json

# Email
EMAIL_ADDRESS=HajjUmrah.co <no-reply@example.com>
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
SERVER_EMAIL=no-reply@example.com
SERVER_EMAIL_PASSWORD=replace-with-email-password
EMAIL_SEND_TIMEOUT_SECONDS=20
EMAIL_OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=60

# SMS gateway
SMS_GATEWAY_API_KEY=replace-with-sms-gateway-api-key

# Frontend URLs
OPERATOR_PANEL_BASE_URL=http://localhost:3000

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info
