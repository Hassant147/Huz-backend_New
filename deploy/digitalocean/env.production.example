# Copy this file to /etc/huz-backend.env on the server.
# Then replace every placeholder with your real production value.

DJANGO_SETTINGS_MODULE=huz.settings
APP_ENV=production

# Reviewed deployment topology
API_PUBLIC_ORIGIN=https://hajjumrah.org
WEB_APP_ORIGIN=https://hajjumrah.co
OPERATOR_APP_ORIGIN=https://operator.hajjumrah.co
ADMIN_APP_ORIGIN=https://huzadmin.hajjumrah.co
ALLOW_LOCALHOST_ORIGINS=False

# Django security
SECRET_KEY=replace-with-a-new-long-random-secret
SECRET_KEY1=
SECRET_KEY2=
# ALLOWED_HOSTS is for the backend hostnames Django serves directly.
# Frontend browser domains belong in CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS instead.
ALLOWED_HOSTS=hajjumrah.org,www.hajjumrah.org
# Include all deployed browser origins that call the backend. The admin
# frontend is cross-site relative to the API, so its origin must be explicit.
CSRF_TRUSTED_ORIGINS=https://hajjumrah.org,https://www.hajjumrah.org,https://hajjumrah.co,https://www.hajjumrah.co,https://operator.hajjumrah.co,https://huzadmin.hajjumrah.co
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
USE_X_FORWARDED_HOST=True

# API docs
ENABLE_API_DOCS=False

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
# Include every deployed browser origin that calls the backend.
CORS_ALLOWED_ORIGINS=https://hajjumrah.co,https://www.hajjumrah.co,https://operator.hajjumrah.co,https://huzadmin.hajjumrah.co
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_HEADERS=

# Database
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=replace-with-db-host
DB_PORT=replace-with-db-port
DB_CONN_MAX_AGE=300
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SSL_CA=

# Static and media
SERVE_MEDIA_AND_STATIC_FROM_DJANGO=False
STATIC_ROOT=/srv/huz-backend/staticfiles
MEDIA_ROOT=/srv/huz-media
VIEW_LOG_PATH=/srv/huz-backend/view_logs.txt

# External files
FIREBASE_CREDENTIAL_PATH=

# Email
EMAIL_DELIVERY_BACKEND=smtp
EMAIL_ADDRESS=HajjUmrah.co <no-reply@example.com>
EMAIL_ENVELOPE_SENDER=no-reply@example.com
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
SERVER_EMAIL=no-reply@example.com
SERVER_EMAIL_PASSWORD=replace-with-email-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_STARTTLS_PORT=587
EMAIL_ALLOW_STARTTLS_FALLBACK=True
EMAIL_LOCAL_HOSTNAME=
EMAIL_SEND_TIMEOUT_SECONDS=20
EMAIL_TRANSIENT_SMTP_RETRIES=2
EMAIL_TRANSIENT_SMTP_RETRY_DELAY_SECONDS=2
EMAIL_OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=60

# SMS gateway
SMS_GATEWAY_API_KEY=replace-with-sms-gateway-api-key

# Frontend URLs
OPERATOR_PANEL_BASE_URL=https://operator.hajjumrah.co

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info
