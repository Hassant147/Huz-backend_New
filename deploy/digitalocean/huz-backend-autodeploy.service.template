[Unit]
Description=Auto deploy Huz backend from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=__APP_DIR__
Environment=APP_DIR=__APP_DIR__
Environment=APP_USER=__APP_USER__
Environment=BRANCH=__BRANCH__
ExecStart=/bin/bash __APP_DIR__/deploy/digitalocean/autodeploy_main.sh
